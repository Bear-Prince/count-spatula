// Dev container for count-spatula. Works locally in VS Code or in GitHub Codespaces, so the
// project (and Claude Code) can be picked up from any device. The gridfinity_build123d
// dependency requires Linux x86_64, which this image provides on both hosts.
// Format: https://aka.ms/devcontainer.json
{
	"name": "count-spatula",
	"image": "mcr.microsoft.com/devcontainers/python:2-3.13-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/starship:1": {},
		"ghcr.io/devcontainers-extra/features/uv:1": {},
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers-extra/features/pnpm:2": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	// libgl1 (Mesa) is required by OCP/build123d's OpenCASCADE bindings even for headless
	// geometry builds; the base Python image doesn't include it. `apt-get update` is allowed
	// to fail here (an unrelated third-party repo added by the node feature can be unsigned)
	// as long as the Debian package lists it needs land.
	// Then install the Python environment, Node tooling (openspec, markdownlint), and git hooks.
	"postCreateCommand": "sudo apt-get update || true && sudo apt-get install -y libgl1 && uv sync && pnpm install && uv run pre-commit install",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"charliermarsh.ruff",
				"mtsmfm.vscode-stl-viewer"
			]
		}
	}
}
